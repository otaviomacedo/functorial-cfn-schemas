// Same API as apigw-items-api.instance, but against the UNIFIED schema: there is
// only one Method type, and authorization is an optional `Authorizer` reference
// rather than a separate AuthMethod. Public methods simply omit it.

instance of "./apigw-unified.schema"

res ItemsApi: Functorial::APIGW::Api = {
    Name: "items-service"
    Description: "Items CRUD API"
}

res Prod: Functorial::APIGW::Stage = {
    StageName: "prod"
    Api: ItemsApi
}

res LambdaAuth: Functorial::APIGW::Authorizer = {
    Name: "lambda-authorizer"
    Type: "REQUEST"
    Uri: !Sub "arn:aws:apigateway:${AWS::Region}:lambda:path/2015-03-31/functions/${AuthFn.Arn}/invocations"
    Api: ItemsApi
}

// Top-level: /items
res ItemsRoute: Functorial::APIGW::Route = {
    Path: "items"
    Api: ItemsApi
}

// Nested: /items/{id}
res ItemRoute: Functorial::APIGW::SubRoute = {
    Path: "{id}"
    Parent: ItemsRoute
}

// Public: GET /items (no authorizer)
res ListItems: Functorial::APIGW::Method = {
    HttpMethod: "GET"
    Auth: "NONE"
    Route: ItemsRoute
    IntegrationType: "AWS_PROXY"
    IntegrationUri: !Sub "arn:aws:apigateway:${AWS::Region}:lambda:path/2015-03-31/functions/${ListItemsFn.Arn}/invocations"
}

// Authorized: POST /items (references the shared authorizer)
res CreateItem: Functorial::APIGW::Method = {
    HttpMethod: "POST"
    Auth: "CUSTOM"
    Route: ItemsRoute
    Authorizer: LambdaAuth
    IntegrationType: "AWS_PROXY"
    IntegrationUri: !Sub "arn:aws:apigateway:${AWS::Region}:lambda:path/2015-03-31/functions/${CreateItemFn.Arn}/invocations"
}

// Authorized: GET /items/{id} (references the same shared authorizer)
res GetItem: Functorial::APIGW::Method = {
    HttpMethod: "GET"
    Auth: "CUSTOM"
    Route: ItemsRoute
    Authorizer: LambdaAuth
    IntegrationType: "AWS_PROXY"
    IntegrationUri: !Sub "arn:aws:apigateway:${AWS::Region}:lambda:path/2015-03-31/functions/${GetItemFn.Arn}/invocations"
}

// Authorized: DELETE /items/{id} (references the same shared authorizer)
res DeleteItem: Functorial::APIGW::Method = {
    HttpMethod: "DELETE"
    Auth: "CUSTOM"
    Route: ItemsRoute
    Authorizer: LambdaAuth
    IntegrationType: "AWS_PROXY"
    IntegrationUri: !Sub "arn:aws:apigateway:${AWS::Region}:lambda:path/2015-03-31/functions/${DeleteItemFn.Arn}/invocations"
}